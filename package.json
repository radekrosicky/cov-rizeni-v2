{
  "name": "cov-rizeni-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ČOV Řízení 2.0 – jednoduchý pracovní nástroj pro řízení realizací ČOV (etapa V2-0: technický základ)",
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build",
    "start": "next start --hostname localhost --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  }
}
