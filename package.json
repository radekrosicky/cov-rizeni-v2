{
  "name": "cov-rizeni-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ČOV Řízení 2.0 – jednoduchý pracovní nástroj pro řízení realizací ČOV (etapa V2-1: zakázka, uživatelé, oprávnění, události)",
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build",
    "start": "next start --hostname localhost --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:setup": "node scripts/db-setup.ts",
    "db:reset": "node scripts/db-setup.ts --reset",
    "db:migrate": "node scripts/db-migrate.ts",
    "test:e2e": "playwright test --trace off"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.14"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  }
}
